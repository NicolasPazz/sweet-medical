# --- Frontend Next.js (cambiar en AWS / Vercel / Amplify) ---
# Puerto del servidor Next (dev y start). En prod suele ser 3000 o el que asigne la plataforma.
PORT=3000
# En contenedores/AWS: escuchar en todas las interfaces
HOSTNAME=0.0.0.0

# --- API backend (obligatoria en build de producción) ---
# Debe coincidir con API_PUBLIC_URL del backend desplegado.
NEXT_PUBLIC_API_URL=http://localhost:3001
