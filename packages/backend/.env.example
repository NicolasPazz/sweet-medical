# --- Servidor (cambiar solo estas en AWS para apuntar al entorno) ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# URL pública del API (Swagger, logs). En prod: https://api.tu-dominio.com
API_PUBLIC_URL=http://localhost:3001

# --- Base de datos (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sweet_medical_db

# Nombre del Replica Set LOCAL, necesario para poder usar transacciones
# (ver docs/mongodb-local-replica-set.md). Dejar SIN DEFINIR cuando se usa
# Atlas: el replicaSet ya viene incluido en la URI mongodb+srv://...
MONGODB_REPLICA_SET=rs0

# --- CORS: orígenes del frontend, separados por coma. Soporta wildcard (*)
# para compartir el proyecto vía VS Code Port Forwarding / Codespaces sin
# tener que editar esto cada vez que cambia el subdominio del túnel. ---
ALLOWED_ORIGINS=http://localhost:3000,https://*.devtunnels.ms,https://*.app.github.dev

# --- Reglas de negocio ---
DURACION_SLOT_MINUTOS=30
NUM_SEMANAS_GENERAR_SLOTS=4
DEFAULT_COPAGO=0.5
