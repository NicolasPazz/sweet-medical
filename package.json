{
  "name": "sweet-medical",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "// --- DESARROLLO (DEV) ---": "--------------------------------------------------",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @sweet-medical/backend",
    "dev:frontend": "npm run dev -w @sweet-medical/frontend",
    "// --- PRODUCCIÓN (BUILD/START) ---": "-------------------------------------------",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build -w @sweet-medical/frontend",
    "build:backend": "npm run build -w @sweet-medical/backend",
    "start": "concurrently -n backend,frontend -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm start -w @sweet-medical/backend",
    "start:frontend": "npm start -w @sweet-medical/frontend",
    "// --- CALIDAD (LINT/FORMAT/TEST) ---": "-----------------------------------------",
    "lint:backend": "npm -w @sweet-medical/backend run lint",
    "lint:frontend": "npm -w @sweet-medical/frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "format": "prettier --write \"packages/**/*.{js,jsx,mjs,cjs,json,css,md}\"",
    "fix:backend": "npm -w @sweet-medical/backend run lint:fix",
    "fix:frontend": "npm -w @sweet-medical/frontend run lint:fix",
    "fix:all": "npm run format && npm run fix:backend && npm run fix:frontend",
    "// --- PRUEBAS UNITARIAS ---": "-------------------------------------------",
    "test": "concurrently -n back,front -c blue,green \"npm run test:backend:silent\" \"npm run test:frontend:silent\"",
    "test:backend": "npm test -w @sweet-medical/backend",
    "test:backend:verbose": "npm test -w @sweet-medical/backend -- --verbose",
    "test:backend:silent": "npm test -w @sweet-medical/backend -- --silent",
    "test:frontend": "npm test -w @sweet-medical/frontend",
    "test:frontend:verbose": "npm test -w @sweet-medical/frontend -- --verbose",
    "test:frontend:silent": "npm test -w @sweet-medical/frontend -- --silent",
    "// --- PRUEBAS E2E (LOCAL) ---": "--------------------------------------------------",
    "test:e2e": "npm run test:e2e -w @sweet-medical/e2e",
    "test:e2e:headed": "npm run test:e2e:headed -w @sweet-medical/e2e",
    "test:e2e:slow": "npm run test:e2e:slow -w @sweet-medical/e2e",
    "test:e2e:debug": "npm run test:e2e:debug -w @sweet-medical/e2e",
    "test:e2e:ui": "npm run test:e2e:ui -w @sweet-medical/e2e",
    "// --- PRUEBAS E2E (PRODUCCIÓN) ---": "------------------------------------",
    "test:prod:e2e": "cross-env BASE_URL=https://sweetmedical.ddns.net npm run test:e2e -w @sweet-medical/e2e",
    "test:prod:e2e:headed": "cross-env BASE_URL=https://sweetmedical.ddns.net npm run test:e2e:headed -w @sweet-medical/e2e",
    "test:prod:e2e:debug": "cross-env BASE_URL=https://sweetmedical.ddns.net npm run test:e2e:debug -w @sweet-medical/e2e",
    "test:prod:e2e:ui": "cross-env BASE_URL=https://sweetmedical.ddns.net npm run test:e2e:ui -w @sweet-medical/e2e",
    "// --- REPORTES E2E ---": "-------------------------------------------------------",
    "report:e2e": "npm run report -w @sweet-medical/e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Sweet Medical — monorepo de gestión médica",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "antd": "^6.4.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.0.8",
    "mongoose": "^9.6.2",
    "react-icons": "^5.6.0",
    "swagger": "^0.7.5",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
