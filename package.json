{
  "name": "sweet-medical",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace=@sweet-medical/backend\" \"npm run dev --workspace=@sweet-medical/frontend\"",
    "start": "concurrently -n backend,frontend -c blue,green \"npm start --workspace=@sweet-medical/backend\" \"npm start --workspace=@sweet-medical/frontend\"",
    "build": "npm run build --workspace=@sweet-medical/frontend",
    "dev:backend": "npm run dev --workspace=@sweet-medical/backend",
    "dev:frontend": "npm run dev --workspace=@sweet-medical/frontend",
    "start:backend": "npm start --workspace=@sweet-medical/backend",
    "start:frontend": "npm start --workspace=@sweet-medical/frontend",
    "test:backend": "npm test --workspace=@sweet-medical/backend -- --verbose",
    "test:coverage:backend": "npm run test:backend -- --coverage",
    "lint:backend": "npm -w @sweet-medical/backend run lint",
    "lint:frontend": "npm -w @sweet-medical/frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "format": "prettier --write \"packages/backend/**/*.{js,mjs,cjs}\" \"packages/frontend/**/*.{js,jsx,mjs,cjs}\"",
    "fix:all": "npm run format && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Sweet Medical — monorepo de gestión médica",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.2",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
